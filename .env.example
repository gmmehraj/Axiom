# ============================================================
# AXIOM — Environment variable reference (EXAMPLE ONLY)
# ------------------------------------------------------------
# Copy this file's variable names into your host's real environment
# variable settings. Never fill in real values here and never commit
# a file named .env, .env.local, etc. — see .gitignore.
# ============================================================

# ---- Frontend / build-time (browser-safe) ----
# Read by scripts/inject-env.js during `npm run build` and written into
# the git-ignored js/core/env.config.js. Set these in Vercel → Project
# Settings → Environment Variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Supabase Edge Functions (server-only secrets) ----
# Set with: supabase secrets set OPENROUTER_API_KEY=... --project-ref <ref>
# Never expose these to the frontend or commit real values.
OPENROUTER_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
